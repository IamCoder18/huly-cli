{
  "name": "huly-cli-monorepo",
  "version": "0.1.4",
  "private": true,
  "description": "Monorepo for @iamcoder18/huly-cli and the huly Agent Skill",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @iamcoder18/huly-cli build",
    "dev": "pnpm --filter @iamcoder18/huly-cli dev",
    "start": "pnpm --filter @iamcoder18/huly-cli start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @iamcoder18/huly-cli test",
    "smoke": "bash scripts/smoke.sh all",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.9.0"
}
